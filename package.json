{
  "name": "faisca-e-pavio",
  "private": true,
  "version": "0.1.0",
  "description": "Run'n'gun de chefes 2D para navegador com estética de desenho animado dos anos 1930.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:data && tsc --noEmit && vite build && tsx tools/post-build.ts dist && npm run check:bundle",
    "build:e2e": "vite build --mode e2e && tsx tools/post-build.ts dist-e2e",
    "preview": "tsx tools/preview-server.ts --dir dist --port 4173",
    "preview:e2e": "tsx tools/preview-server.ts --dir dist-e2e --port 4174",
    "assets": "tsx tools/build-assets.ts",
    "validate:data": "tsx tools/validate-data.ts",
    "validate:balance": "tsx tools/validate-balance.ts",
    "check:bundle": "tsx tools/check-bundle.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts --project=chromium"
  },
  "dependencies": {
    "@fontsource/josefin-sans": "5.3.0",
    "@fontsource/limelight": "5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.9",
    "sharp": "0.35.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
